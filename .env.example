# OAuth token from Claude Code (overrides credential file lookup)
# Get yours: run `claude auth status` or check ~/.claude/.credentials.json
# Two options: set OAUTH_TOKEN here, OR rely on the ~/.claude volume mount in docker-compose.yml
# OAUTH_TOKEN=sk-ant-...

# Override proxy port (default: 18801)
# PROXY_PORT=18801

# Bind address (default: 127.0.0.1, localhost only)
# Docker Compose sets this to 0.0.0.0 automatically -- do NOT change
# unless you understand the security implications.
# Outside Docker, leave this unset to bind to localhost only.
# PROXY_HOST=127.0.0.1

# API key authentication. The keys file is a JSON array of objects:
# [{"name":"OpenClaw","key_hash":"<sha256 hex of API key>"}]
# Docker users should mount the file at the same path.
# KEYS_FILE=/app/keys.json

# Optional diagnostics. Dumps may contain full request/response payloads.
# BILLING_PROXY_DUMP_DIR=/tmp/billing-proxy-dumps
# BILLING_PROXY_REQUEST_DUMP=0
# BILLING_PROXY_RAW_DUMP=0

# Optional defensive deduplication for repeated assistant messages or repeated
# response tails. Keep disabled unless you are debugging duplicate output.
# BILLING_PROXY_REQUEST_DEDUP=0
# BILLING_PROXY_RESPONSE_DEDUP=0
